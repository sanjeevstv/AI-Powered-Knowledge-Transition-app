# SQLite (default) — use postgresql+psycopg://user:pass@host/db for Postgres
DATABASE_URL=sqlite:///./kt_platform.db

# LLM (optional — if unset, the API uses deterministic stubs for demos)
# Put real values in `.env` only (never commit secrets). Copy this file: cp .env.example .env
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL (e.g. Azure, corporate proxy, local gateway)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# If your gateway has chat/completions but NOT OpenAI-compatible /v1/embeddings, set true so
# Chroma uses local pseudo-embeddings while summaries/chat still call the gateway.
OPENAI_USE_PSEUDO_EMBEDDINGS=false

# Embeddings for Chroma (only used when OPENAI_API_KEY is set AND OPENAI_USE_PSEUDO_EMBEDDINGS=false)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector store
CHROMA_PERSIST_DIR=./chroma_data

# Upload storage (relative to apps/api working directory when running locally)
DATA_UPLOAD_DIR=./uploads

# Dashboard: documents uploaded / expected (Section 13 coverage KPI)
EXPECTED_DOCUMENTS=10

# API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT — set in production (32+ random bytes). Omit or leave empty for local dev (API uses a built-in default).
JWT_SECRET=
